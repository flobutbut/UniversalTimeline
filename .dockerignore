!package.json
!yarn.lock
!tsconfig*.json
!vite.config.ts
!vitest.config.ts
!index.html
!public/
!public/**
!src/
!src/**
!server/
!server/package.json
!server/yarn.lock
!server/tsconfig.json
!server/src/
!server/src/**
!server/test/
!server/test/**
!server/certs/
!server/certs/*.crt
!database/
!database/**
!scripts/
!scripts/check.mjs
!scripts/check-design-system.mjs
!scripts/lib/
!scripts/lib/config-review.mjs
!tools/
!tools/checks/
!tools/checks/Dockerfile
**/.env
**/.env.*
**/*.local
**/*.local.*
