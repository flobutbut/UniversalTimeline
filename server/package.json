{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "dev:tsx-watch": "tsx watch src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/index.js",
    "test:hierarchy": "yarn build && node --test test/periodHierarchy.postgres.mjs",
    "test:deletion": "yarn build && node --test test/periodDeletion.postgres.mjs",
    "test:privileges": "node --test test/functionPrivileges.postgres.mjs",
    "test:atomic": "yarn build && node --experimental-test-module-mocks --test test/atomicWrites.postgres.mjs",
    "test:profiles": "yarn build && node --experimental-test-module-mocks --test test/profiles.postgres.mjs",
    "test:admin": "yarn build && node --experimental-test-module-mocks --test test/admin.postgres.mjs",
    "test:wikidata": "yarn build && node --experimental-test-module-mocks --test test/wikidataGeneration.postgres.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@vercel/functions": "3.11.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "4.22.3",
    "nodemailer": "10.4.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.13",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.11.2",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.23.1",
    "yarn": "1.22.x"
  },
  "packageManager": "yarn@1.22.22"
}
