# Supabase Dashboard > Connect > Session pooler (IPv4).
# Copy the real host/user from the dashboard; encode reserved password characters.
# Keep credentials server-side: never use a VITE_ prefix.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Download the database CA certificate from Supabase if required by your project.
# DB_SSL_CA_PATH=/absolute/path/to/prod-supabase.cer
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Existing project: access migration already applied. Empty project: apply database/baseline/application.sql only.
# Keep false only during local preparation; production startup requires true.
AUTH_ENABLED=false
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: feedback notifications (separate from the SMTP configured inside Supabase Auth).
# Add these server-side in server/.env and Vercel. Never use a VITE_ prefix.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=florian@universaltimeline.net
SMTP_FROM=florian@universaltimeline.net
SMTP_PASSWORD=
