# Browser-safe configuration only. Never put DATABASE_URL or a secret key here.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Audience measurement (cookies). Leave empty to disable it: the consent banner appears only when a
# provider is set, and the tracker starts through useConsentStore().registerTracker after consent.
# Set to "posthog" with the public project token (phc_…) and the ingestion host (https://eu.i.posthog.com).
VITE_ANALYTICS_PROVIDER=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
