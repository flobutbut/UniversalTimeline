# Browser-safe configuration only. Never put DATABASE_URL or a secret key here.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Audience measurement (cookies). Leave empty until a tracker is installed: the consent banner
# appears only when a provider is set, and the tracker must start through useConsentStore().registerTracker.
VITE_ANALYTICS_PROVIDER=
