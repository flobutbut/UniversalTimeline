{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "routes": [
        {
          "src": "^/(voyage|timeline|catalogue|search|generate|database|periods|graph|events|admin|profile|design-system|contact|legal|login|reset-password|forbidden)/?$",
          "dest": "/__seo__/$1.html"
        },
        {
          "src": "^/legal/(mentions-legales|confidentialite|cookies|conditions)/?$",
          "dest": "/__seo__/legal/$1.html"
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "^/.*$",
          "dest": "/404.html",
          "status": 404
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/vercel.ts",
      "buildCommand": "tsc --noEmit",
      "functions": {
        "src/vercel.ts": {
          "includeFiles": "{package.json,certs/prod-ca-2021.crt}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/timeline",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/timeline/",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
