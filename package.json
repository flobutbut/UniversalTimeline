{
  "name": "api-wikidata",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n api,ui -c blue,green \"yarn server\" \"yarn dev\"",
    "dev:all:fresh": "bash scripts/dev-all.sh",
    "daemon:up": "bash scripts/daemon-up.sh",
    "daemon:down": "pm2 delete chronologie-api chronologie-ui",
    "daemon:restart": "pm2 restart chronologie-api chronologie-ui",
    "daemon:logs": "pm2 logs chronologie-api chronologie-ui --lines 80",
    "daemon:status": "pm2 status",
    "build": "vue-tsc -b && vite build",
    "verify": "node scripts/check.mjs",
    "verify:design": "node scripts/check-design-system.mjs",
    "verify:clean": "node scripts/check-clean.mjs",
    "verify:config": "node --experimental-strip-types scripts/check-config.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --api.host 127.0.0.1 --no-open",
    "server": "yarn --cwd server dev"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "1.21.0",
    "d3": "7.9.0",
    "pinia": "^3.0.4",
    "posthog-js": "^1.444.3",
    "uuid": "11.1.1",
    "vue": "3.5.44",
    "vue-router": "4"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/node": "^22.13.13",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "@vue/compiler-dom": "3.5.44",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "10.0.6",
    "jsdom": "^26.0.0",
    "pm2": "7.1.1",
    "typescript": "~5.7.2",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-tsc": "^2.2.4"
  },
  "resolutions": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": ">=22.23.1",
    "yarn": "1.22.x"
  },
  "packageManager": "yarn@1.22.22"
}
